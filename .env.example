# 관심 분야 (쉼표 구분) — 이 키워드로 공고를 거른다
INTERESTS=AI 개발,데이터 분석,머신러닝
# 수집 대상: dacon(DACON) | daker(DAKER, DACON 해커톤 원문) | dev_event(Dev-Event)
SOURCES=dacon,daker,dev_event

# LLM: gemini | openai | none   (none 이거나 키가 없으면 규칙 기반으로 대체 — 그래도 전체가 동작)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# 카카오톡 '나에게 보내기' (README 4장 참고)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/callback

# 상세 페이지 공개 주소: outbox/pages/ 를 올린 웹 주소 (예: https://<id>.github.io/contest-pages)
# 비어 있으면 로컬 파일 주소라 휴대폰에서 열리지 않으므로, 실제 발송은 리뷰 단계에서 막힌다.
PAGES_BASE_URL=

# 안전장치: 1 이면 실제 발송하지 않고 outbox/ 에 미리보기만 저장
DRY_RUN=1
MIN_ITEMS=3
MAX_ATTEMPTS=2
MAX_KAKAO_ITEMS=5
